#!/bin/bash

set -e

[[ $EUID -ne 0 ]] && {
    printf "%s: this program requires root privileges. try again with \`sudo'?\n" "$0" >&2
    exit 1
}

ACTION=$1
INSTANCE_NAME=$2
WG_CONF_DIR="/etc/wireguard"
WG_CONF_FILE="${WG_CONF_DIR}/${INSTANCE_NAME}.conf"
ETC_PATH="/var/ns-etc/${INSTANCE_NAME}"

# Allow overriding wg-quick command, default to wg-quick if not set
WG_CMD_ACTUAL="${WG_QUICK_CMD:-wg-quick}"

# Function to extract DNS servers from WireGuard config
get_dns_servers() {
    if [[ -f "$WG_CONF_FILE" ]]; then
        grep -E '^\s*DNS\s*=' "$WG_CONF_FILE" | sed -E 's/^\s*DNS\s*=\s*//; s/[, \t]+/\n/g'
    fi
}

generate_resolvconf() {
    local dns_servers
    dns_servers=$(get_dns_servers)

    if [[ -n "$dns_servers" ]]; then
        printf '# Generated by wg-ns for %s\n' "$INSTANCE_NAME" > "${ETC_PATH}/resolv.conf.tmp"
        echo "$dns_servers" | while read -r server; do
            printf 'nameserver %s\n' "$server" >> "${ETC_PATH}/resolv.conf.tmp"
        done
        # Atomically replace resolv.conf
        mv "${ETC_PATH}/resolv.conf.tmp" "${ETC_PATH}/resolv.conf"
    else
        # If no DNS servers are specified in the WG config,
        # remove any existing custom resolv.conf to revert to default.
        rm -f "${ETC_PATH}/resolv.conf"
    fi
}

if [[ -z "$ACTION" || -z "$INSTANCE_NAME" ]]; then
    printf "Usage: %s <up|down> <instance_name>\n" "$0" >&2
    exit 1
fi

if [[ ! -f "$WG_CONF_FILE" ]]; then
    printf "WireGuard configuration file %s not found.\n" "$WG_CONF_FILE" >&2
    exit 1
fi

# Ensure the network namespace itself is set up (dependency of the systemd service)
# We don't create it here, but we check if it exists as a basic sanity check.
if ! ip netns list | grep -qw "$INSTANCE_NAME"; then
    # The netns@.service should have created this.
    # If running manually, ensure 'netns@<instance_name>.service' is active or 'ip netns add <instance_name>' was run.
    printf "Network namespace '%s' does not exist. Ensure netns@%s.service is active.\n" "$INSTANCE_NAME" "$INSTANCE_NAME" >&2
    # exit 1 # Decided to comment this out, systemd should handle dependencies.
             # If run manually, user should ensure ns exists.
fi


case $ACTION in
    up)
        printf "Bringing up WireGuard interface wg-%s in namespace %s...\n" "$INSTANCE_NAME" "$INSTANCE_NAME"

        # Create the /var/ns-etc/<nsname> directory if it doesn't exist
        mkdir -p "$ETC_PATH"

        # Use wg-quick to bring up the interface within the namespace
        # wg-quick will create an interface named after the conf file, e.g. wg-<instance_name>
        # However, wg-quick itself doesn't have a direct --namespace option.
        # We use ip netns exec for the wg-quick command.
        # wg-quick itself will try to move the link if it's created outside,
        # but it's cleaner to ensure it's created inside from the start.
        # The standard interface name wg-quick uses is the name of the config file.
        # So for <instance_name>.conf, it creates an interface named <instance_name>.
        # Let's stick to that convention for the interface name *inside* the namespace.
        # The physical interface will be moved by wg-quick.

        # Correct approach: wg-quick up moves the interface itself.
        # We need to ensure the commands *within* wg-quick that modify resolv.conf
        # happen in the context of the overlayfs mount.
        # The `wg-quick` script has PreUp, PostUp, PreDown, PostDown hooks.
        # The most robust way is to ensure wg-quick itself is executed within the namespace
        # for `up` and `down` operations related to interface and routing.
        # DNS is tricky because wg-quick uses resolvconf if available, or writes to /etc/resolv.conf.
        # Since we have the overlayfs, writing to /etc/resolv.conf *inside the namespace* is correct.

        # Ensure lo is up in the namespace
        ip netns exec "$INSTANCE_NAME" ip link set dev lo up

        # Bring up the WireGuard interface using the configured command within the namespace
        # This ensures that all of its operations (interface creation, IP assignment, routing, DNS)
        # are attempted within the namespace context.
        ip netns exec "$INSTANCE_NAME" "${WG_CMD_ACTUAL}" up "$WG_CONF_FILE"

        # Handle DNS separately if the WireGuard command doesn't do it or if we want more control
        # For systemd-resolved systems, the command might use `resolvectl dns <iface> <dns_servers>`
        # For other systems, it might directly write to /etc/resolv.conf
        # Our overlayfs setup means modifying /etc/resolv.conf inside the ns is fine.
        # The `generate_resolvconf` function will write to `/var/ns-etc/$INSTANCE_NAME/resolv.conf`
        # which will appear as `/etc/resolv.conf` inside the namespace due to overlayfs.
        # We call this *after* the up command in case it itself tries to manage resolv.conf.
        # Our version will then overwrite it if DNS is specified in the .conf.
        generate_resolvconf

        printf "WireGuard interface for %s should be up in namespace %s.\n" "$INSTANCE_NAME" "$INSTANCE_NAME"
    ;;
    down)
        printf "Bringing down WireGuard interface for %s in namespace %s...\n" "$INSTANCE_NAME" "$INSTANCE_NAME"

        # Bring down the WireGuard interface using the configured command within the namespace
        ip netns exec "$INSTANCE_NAME" "${WG_CMD_ACTUAL}" down "$WG_CONF_FILE"

        # Clean up custom resolv.conf
        rm -f "${ETC_PATH}/resolv.conf"
        # If ETC_PATH is empty, remove it.
        find "$ETC_PATH" -maxdepth 0 -empty -exec rmdir {} \;


        printf "WireGuard interface for %s should be down.\n" "$INSTANCE_NAME"
    ;;
    *)
        printf "Invalid action: %s. Use 'up' or 'down'.\n" "$ACTION" >&2
        exit 1
    ;;
esac

exit 0
